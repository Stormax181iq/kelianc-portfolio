# ===================================================================
# kelianc-portfolio — environment variables
# Copy this file to .env and fill in the values YOURSELF.
# .env is gitignored: no real secret, token, password or personal
# address may ever be committed to the repository.
# ===================================================================

# --- Database (PostgreSQL) -----------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=portfolio
DB_USER=portfolio
# Local PostgreSQL password — fill in yourself, never commit it.
DB_PASSWORD=

# --- API server (apps/api) -----------------------------------------
API_PORT=4000
NODE_ENV=development
# Long random string used to sign admin session cookies.
# Generate one yourself, e.g.:  openssl rand -base64 48
SESSION_SECRET=
# Name of the HttpOnly session cookie used by the admin app.
ADMIN_COOKIE_NAME=kelianc_admin_session
# Comma-separated list of allowed origins for CORS (public site, admin).
CORS_ORIGIN=http://localhost:5173,http://localhost:4001

# --- GitHub API (project cards) ------------------------------------
# Public repos work without a token; a token only raises rate limits.
GITHUB_USERNAME=Stormax181iq
GITHUB_TOKEN=
# Server-side cache TTL for GitHub API responses, in seconds.
GITHUB_CACHE_TTL=3600

# --- Contact form ---------------------------------------------------
# Recipient of contact-form notifications. NEVER commit the real value;
# it must not appear in code, UI or git history either.
CONTACT_TO=
# Delivery channel 1: self-hosted SMTP (your own mail server/domain).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Delivery channel 2 (fallback): transactional email API, e.g. Resend
# (free tier). Create the key yourself at https://resend.com
RESEND_API_KEY=
# Sender address used for API fallback (until a domain is verified,
# Resend requires a resend.dev test address).
RESEND_FROM=
# Rate limiting for the contact form (requests per IP per window).
CONTACT_RATE_LIMIT_MAX=5
CONTACT_RATE_LIMIT_WINDOW_MS=3600000

# --- Admin bootstrap (used once by `npm run admin:create`) ---------
# Credentials for the FIRST admin account. Fill in yourself, run the
# script once, then remove the values from .env. No default password
# exists in the repository.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Frontends (Vite) -----------------------------------------------
VITE_API_URL=http://localhost:4000
# Public site base URL — used for canonical URLs and hreflang tags.
SITE_URL=http://localhost:5173
# Admin app port (separate build, separate origin).
ADMIN_PORT=4001
WEB_PORT=5173
